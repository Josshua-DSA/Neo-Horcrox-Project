# =============================================================
# .gitattributes — Neo Horcrox Supply Chain
# Ensures consistent line endings and correct diff rendering
# on GitHub compare / pull request views.
# =============================================================

# --- Default: normalize all text files to LF in the repo ---
* text=auto eol=lf

# --- Source code: always LF ---
*.py        text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.sh        text eol=lf
*.env       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.sql       text eol=lf
*.csv       text eol=lf

# --- Docker ---
Dockerfile  text eol=lf
.dockerignore text eol=lf

# --- Git config ---
.gitignore    text eol=lf
.gitattributes text eol=lf

# --- Binary files: never diff / never convert ---
*.pkl     binary
*.joblib  binary
*.h5      binary
*.pt      binary
*.pth     binary
*.onnx    binary
*.ubj     binary
*.sav     binary

# --- Images ---
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.webp binary

# --- Archives ---
*.zip  binary
*.tar  binary
*.gz   binary
*.bz2  binary

# --- Notebooks: treat as text but no eol conversion ---
*.ipynb text eol=lf

# --- Database ---
*.pgerd binary
